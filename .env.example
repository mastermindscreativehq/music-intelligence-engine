# =============================================================================
# MUSIC INTELLIGENCE ENGINE — Local Environment
# NEVER commit this file to Git.
# =============================================================================


# ---- Application ------------------------------------------------------------
MIE_ENV=development
MIE_LOG_LEVEL=INFO


# ---- Database (PostgreSQL / Supabase) ---------------------------------------
# Radio Discovery persistence currently uses MIE_PG_DSN.
# Paste your Supabase PostgreSQL connection URI below.

MIE_PG_DSN=postgresql://postgres.qsappsjzxdcytduaynes:Handsomeboyjoel-1@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Keep this only if existing application code still uses DATABASE_URL.
# Use the same connection string for now.
DATABASE_URL=postgresql://postgres.qsappsjzxdcytduaynes:Handsomeboyjoel-1@aws-1-eu-west-1.pooler.supabase.com:5432/postgres


# ---- Supabase API -----------------------------------------------------------
# Leave these empty for now unless the application explicitly needs the
# Supabase HTTP/API client. The current persistence phase uses PostgreSQL.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ---- AI Provider ------------------------------------------------------------
# We are moving this part away from Ollama toward OpenAI.
# Do not paste your API key anywhere except your local .env file.

OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4.1-mini

# Ollama settings retained but disabled for now.
# Do not remove them until we confirm no existing code depends on them.
OLLAMA_BASE_URL=
OLLAMA_MODEL=


# ---- Crawler / Discovery Engine ---------------------------------------------
# Current discovery uses local seed files and bounded crawling.

DISCOVERY_PROVIDER=seed_file
DISCOVERY_SEED_FILE=

CRAWLER_USER_AGENT=MusicIntelligenceEngine/0.2 (+contact: your-email@example.com)
CRAWLER_RATE_LIMIT_REQUESTS_PER_SECOND=1
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_RESPECT_ROBOTS=true
DISCOVERY_MAX_PAGES_PER_SITE=6


# ---- Future: Credentialed Search Provider -----------------------------------
# NOT IMPLEMENTED YET — leave empty.

SEARCH_API_KEY=
SEARCH_API_BASE_URL=


# ---- Future: Outreach Email Provider ----------------------------------------
# NOT IMPLEMENTED YET — leave empty.

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=


# ---- Future: Music Submission Storage ---------------------------------------
# NOT IMPLEMENTED YET — leave empty.

SUBMISSION_STORAGE_BUCKET=
SUBMISSION_STORAGE_REGION=
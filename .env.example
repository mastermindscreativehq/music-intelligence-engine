# =============================================================================
# MUSIC INTELLIGENCE ENGINE — Local Environment
# NEVER commit this file to Git.
# =============================================================================


# ---- Application ------------------------------------------------------------
MIE_ENV=development
MIE_LOG_LEVEL=INFO

# ---- Deployment / hosting ---------------------------------------------------
# Comma-separated list of allowed cross-origin browsers for the FastAPI
# backend (Railway). Set this to the Vercel frontend origin when the console
# is hosted separately, e.g.:
#   MIE_CORS_ORIGINS=https://your-console.vercel.app
# Empty/unset means no cross-origin is allowed (same-origin only).
MIE_CORS_ORIGINS=

# ---- Frontend (Vercel) ------------------------------------------------------
# Origin of the Railway-hosted FastAPI backend. Set this as an environment
# variable on the Vercel deployment (NOT committed). The Vercel build
# substitutes it for __MIE_API_BASE_URL__ in the static assets:
#   MIE_API_BASE_URL=https://your-backend.up.railway.app
# Leave unset for same-origin / local serving.



# ---- Database (PostgreSQL / Supabase) ---------------------------------------
# Radio Discovery persistence currently uses MIE_PG_DSN.
# Paste your Supabase PostgreSQL connection URI below.

MIE_PG_DSN=postgresql://postgres.qsappsjzxdcytduaynes:Handsomeboyjoel-1@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Keep this only if existing application code still uses DATABASE_URL.
# Use the same connection string for now.
DATABASE_URL=postgresql://postgres.qsappsjzxdcytduaynes:Handsomeboyjoel-1@aws-1-eu-west-1.pooler.supabase.com:5432/postgres


# ---- Supabase API -----------------------------------------------------------
# Leave these empty for now unless the application explicitly needs the
# Supabase HTTP/API client. The current persistence phase uses PostgreSQL.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ---- AI Provider ------------------------------------------------------------
# We are moving this part away from Ollama toward OpenAI.
# Do not paste your API key anywhere except your local .env file.

OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4.1-mini

# Ollama settings retained but disabled for now.
# Do not remove them until we confirm no existing code depends on them.
OLLAMA_BASE_URL=
OLLAMA_MODEL=


# ---- Crawler / Discovery Engine ---------------------------------------------
# Current discovery uses local seed files and bounded crawling.

DISCOVERY_PROVIDER=seed_file
DISCOVERY_SEED_FILE=

CRAWLER_USER_AGENT=MusicIntelligenceEngine/0.2 (+contact: your-email@example.com)
CRAWLER_RATE_LIMIT_REQUESTS_PER_SECOND=1
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_RESPECT_ROBOTS=true
DISCOVERY_MAX_PAGES_PER_SITE=6


# ---- Future: Credentialed Search Provider -----------------------------------
# NOT IMPLEMENTED YET — leave empty.

SEARCH_API_KEY=
SEARCH_API_BASE_URL=


# ---- Automation (n8n / scheduler) -------------------------------------------
# Optional shared secret for the automation discovery endpoints
# (POST /api/v1/discovery/jobs). When set, every request must carry
# `Authorization: Bearer <token>` or the endpoint answers 401. Leave
# empty to disable the gate (zero-config local dev).
MIE_AUTOMATION_TOKEN=

# Hosted backend base URL for n8n HTTP Request nodes (no trailing slash).
# Example: https://your-backend.up.railway.app
MIE_BASE_URL=

# n8n credentials — no real secrets here; just the shared automation token
# repeated so n8n can reference it via {{ $env.MIE_AUTOMATION_TOKEN }}.
# The token above must match.
MIE_N8N_AUTH_TOKEN=


# ---- Honest DJ discovery: SerpAPI Google organic search -----------------------
# REQUIRED before live SerpAPI-based DJ discovery becomes configured. Leave
# empty to keep the DJ discovery endpoint answering its honest 503
# (discovery_provider not_configured) — nothing is ever fabricated, and no
# real identification happens without BOTH values set.
#   * `discovery/djs/serpapi_provider.py` reads these two variables.
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search


# ---- Future: Outreach Email Provider ----------------------------------------
# NOT IMPLEMENTED YET — leave empty.

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=


# ---- Future: Music Submission Storage ---------------------------------------
# NOT IMPLEMENTED YET — leave empty.

SUBMISSION_STORAGE_BUCKET=
SUBMISSION_STORAGE_REGION=
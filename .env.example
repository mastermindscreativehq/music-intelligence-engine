# =============================================================================
# MUSIC INTELLIGENCE ENGINE — environment template
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# This file contains variable names and placeholders ONLY. No real credentials.
# =============================================================================

# ---- Application ------------------------------------------------------------
MIE_ENV=development
MIE_LOG_LEVEL=INFO

# ---- Database (PostgreSQL / Supabase) — Phase 6 ------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/music_intelligence
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Local AI (Ollama) -------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Crawler / Discovery engine (Phase 2) ------------------------------------
# Discovery currently uses local seed files; no search-API credentials exist
# or are required. Placeholders below document future knobs only.
DISCOVERY_PROVIDER=seed_file
DISCOVERY_SEED_FILE=
CRAWLER_USER_AGENT=MusicIntelligenceEngine/0.2 (+contact: your-email@example.com)
CRAWLER_RATE_LIMIT_REQUESTS_PER_SECOND=1
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_RESPECT_ROBOTS=true
DISCOVERY_MAX_PAGES_PER_SITE=6

# ---- Future: credentialed search provider (NOT implemented — leave empty) ----
SEARCH_API_KEY=
SEARCH_API_BASE_URL=

# ---- Outreach email provider (Phase 9-10) — leave empty until implemented ----
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# ---- Music submission storage (Phase 8) --------------------------------------
SUBMISSION_STORAGE_BUCKET=
SUBMISSION_STORAGE_REGION=

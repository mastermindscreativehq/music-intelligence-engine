{
  "name": "MIE Daily DJ Discovery",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "029e3f68-9dee-4727-90dc-b4914b8c3014",
      "name": "Schedule daily (06:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per discovery job - append objects to 'jobs' to fan out.\n// organization_type 'dj' keeps the independent-DJ runner untouched.\nconst jobs = [\n  { organization_type: 'dj', query: 'independent DJ', genre: 'Afrobeats', country: 'United States', limit: 25 },\n];\n\nreturn jobs.map((job) => ({ json: job }));"
      },
      "id": "8f34904e-7c78-4129-b258-e8382f5449c5",
      "name": "Build DJ discovery job(s)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MIE_BASE_URL }}/api/v1/discovery/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MIE_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "e2cf22cb-6bc6-4ea0-8237-17e58f89d058",
      "name": "POST /api/v1/discovery/jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The POST now submits and answers 202 immediately with a durable run_id;\n// the SerpAPI + enrichment work runs in the background on the server.\n// Normalize the submission envelope so the poll loop has a stable run_id\n// and an attempt counter.\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const payload = item.json.data ?? item.json;\n  return {\n    json: {\n      attempt: 0,\n      run_id: payload.run_id ?? null,\n      organization_type: payload.organization_type ?? null,\n      status: payload.status ?? 'queued',\n      started_at: payload.started_at ?? null,\n    },\n  };\n});"
      },
      "id": "5dcf38ce-05d5-449c-9f1b-c4f8215c3d72",
      "name": "Record submitted run_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
      "id": "1dcf38ce-05d5-449c-9f1b-c4f8215c3d73",
      "name": "Wait 30s for background job",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MIE_BASE_URL }}/api/v1/discovery/jobs/{{ $json.run_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MIE_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "2dcf38ce-05d5-449c-9f1b-c4f8215c3d74",
      "name": "GET /api/v1/discovery/jobs/{run_id}",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Merge the polled status payload with the running attempt counter and\n// increment it so the poll loop is strictly bounded (see 'Poll limit\n// reached?'). completed_with_failures runs are preserved intact.\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const payload = item.json.data ?? item.json;\n  const run_id = payload.run_id ?? item.json.run_id;\n  return {\n    json: {\n      attempt: (item.json.attempt ?? 0) + 1,\n      run_id,\n      organization_type: payload.organization_type ?? null,\n      status: payload.status ?? 'unknown',\n      provider: payload.provider ?? null,\n      queries_run: payload.queries_run ?? 0,\n      candidates_found: payload.candidates_found ?? 0,\n      records_ingested: payload.records_ingested ?? 0,\n      duplicates: payload.duplicates ?? 0,\n      failures: payload.failures ?? 0,\n      error: payload.error ?? null,\n      started_at: payload.started_at ?? null,\n      completed_at: payload.completed_at ?? null,\n    },\n  };\n});"
      },
      "id": "3dcf38ce-05d5-449c-9f1b-c4f8215c3d75",
      "name": "Track poll attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "queued",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "running",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "4dcf38ce-05d5-449c-9f1b-c4f8215c3d76",
      "name": "Still waiting?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.attempt }}",
              "rightValue": 40,
              "operator": {
                "type": "number",
                "operation": "largerEqual",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5dcf38ce-05d5-449c-9f1b-c4f8215c3d77",
      "name": "Poll limit reached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1880,
        100
      ]
    },
    {
      "parameters": {},
      "id": "6dcf38ce-05d5-449c-9f1b-c4f8215c3d78",
      "name": "Poll timeout",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2120,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7dcf38ce-05d5-449c-9f1b-c4f8215c3d79",
      "name": "Status: completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1880,
        300
      ]
    },
    {
      "parameters": {},
      "id": "8dcf38ce-05d5-449c-9f1b-c4f8215c3d80",
      "name": "Run successful (completed)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2120,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "not_configured",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "9dcf38ce-05d5-449c-9f1b-c4f8215c3d81",
      "name": "Status: failed or not configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1880,
        440
      ]
    },
    {
      "parameters": {},
      "id": "adcf38ce-05d5-449c-9f1b-c4f8215c3d82",
      "name": "Report failure",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2120,
        440
      ]
    },
    {
      "parameters": {},
      "id": "bdcf38ce-05d5-449c-9f1b-c4f8215c3d83",
      "name": "completed_with_failures (preserved)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2120,
        720
      ]
    }
  ],

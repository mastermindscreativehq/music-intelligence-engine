{
  "name": "MIE Daily DJ Discovery",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "029e3f68-9dee-4727-90dc-b4914b8c3014",
      "name": "Schedule daily (06:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per discovery job - append objects to 'jobs' to fan out.\nconst jobs = [\n  { organization_type: 'dj', query: 'independent DJ', genre: 'Afrobeats', country: 'United States', limit: 25 },\n];\n\nreturn jobs.map((job) => ({ json: job }));"
      },
      "id": "8f34904e-7c78-4129-b258-e8382f5449c5",
      "name": "Build DJ discovery job(s)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MIE_BASE_URL }}/api/v1/discovery/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MIE_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "e2cf22cb-6bc6-4ea0-8237-17e58f89d058",
      "name": "POST /api/v1/discovery/jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Flatten the MIE envelope into per-job run metrics.\n// completed_with_failures runs are preserved intact (status + failures\n// count stay visible) instead of being discarded.\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const data = item.json.data ?? item.json;\n  return {\n    json: {\n      ok: item.json.ok,\n      job_type: data.job_type ?? null,\n      run_id: data.run_id ?? null,\n      provider: data.provider ?? null,\n      queries_run: data.queries_run ?? 0,\n      candidates_found: data.candidates_found ?? 0,\n      records_ingested: data.records_ingested ?? 0,\n      duplicates: data.duplicates ?? 0,\n      failures: data.failures ?? 0,\n      status: data.status ?? 'unknown',\n      started_at: data.started_at ?? null,\n      completed_at: data.completed_at ?? null,\n    },\n  };\n});"
      },
      "id": "5dcf38ce-05d5-449c-9f1b-c4f8215c3d7d",
      "name": "Capture run metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ae608631-4f9d-4d11-8a02-281c7cbd8f77",
      "name": "Status: completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {},
      "id": "f63589ff-cd65-4f5a-9d10-12a2307cc2e8",
      "name": "Run successful (completed)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1240,
        160
      ]
    },
    {
      "parameters": {},
      "id": "b7b0f4af-b80d-4b64-a3f3-4ebe762c4a05",
      "name": "completed_with_failures (preserved)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1240,
        460
      ]
    }
  ],
  "connections": {
    "Schedule daily (06:00)": {
      "main": [
        [
          {
            "node": "Build DJ discovery job(s)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build DJ discovery job(s)": {
      "main": [
        [
          {
            "node": "POST /api/v1/discovery/jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /api/v1/discovery/jobs": {
      "main": [
        [
          {
            "node": "Capture run metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Capture run metrics": {
      "main": [
        [
          {
            "node": "Status: completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Status: completed?": {
      "main": [
        [
          {
            "node": "Run successful (completed)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "completed_with_failures (preserved)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
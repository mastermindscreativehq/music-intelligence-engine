{
  "name": "MIE Daily Station Discovery",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "6f1c2a90-3b44-4a1e-9a7c-1d2e3f4a5b60",
      "name": "Schedule daily (07:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per station discovery job - append objects to 'jobs' to fan out.\n// organization_type 'radio' selects the station deep-research runner;\n// 'station' is accepted as an alias. Only shared DiscoveryRequest fields\n// are sent - the provider/API key stays server-side.\nconst jobs = [\n  { organization_type: 'radio', query: 'community radio station', station_type: 'community', country: 'United States', limit: 25 },\n  { organization_type: 'radio', query: 'public radio station', station_type: 'public', country: 'United States', limit: 25 },\n];\n\nreturn jobs.map((job) => ({ json: job }));"
      },
      "id": "a2b3c4d5-e6f7-4a8b-9c0d-1e2f3a4b5c6d",
      "name": "Build station discovery job(s)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MIE_BASE_URL }}/api/v1/discovery/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MIE_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b3c4d5e6-f7a8-4b9c-0d1e-2f3a4b5c6d7e",
      "name": "POST /api/v1/discovery/jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The POST now submits and answers 202 immediately with a durable run_id;\n// the SerpAPI + enrichment work runs in the background on the server.\n// Normalize the submission envelope so the poll loop has a stable run_id\n// and an attempt counter.\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const payload = item.json.data ?? item.json;\n  return {\n    json: {\n      attempt: 0,\n      run_id: payload.run_id ?? null,\n      organization_type: payload.organization_type ?? null,\n      status: payload.status ?? 'queued',\n      started_at: payload.started_at ?? null,\n    },\n  };\n});"
      },
      "id": "c4d5e6f7-a8b9-4c0d-1e2f-3a4b5c6d7e8f",
      "name": "Record submitted run_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
      "id": "d5e6f7a8-b9c0-4d1e-2f3a-4b5c6d7e8f90",
      "name": "Wait 30s for background job",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MIE_BASE_URL }}/api/v1/discovery/jobs/{{ $json.run_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MIE_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "e6f7a8b9-c0d1-4e2f-3a4b-5c6d7e8f9012",
      "name": "GET /api/v1/discovery/jobs/{run_id}",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Merge the polled status payload with the running attempt counter and\n// increment it so the poll loop is strictly bounded (see 'Poll limit\n// reached?'). completed_with_failures runs are preserved intact.\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const payload = item.json.data ?? item.json;\n  const run_id = payload.run_id ?? item.json.run_id;\n  return {\n    json: {\n      attempt: (item.json.attempt ?? 0) + 1,\n      run_id,\n      organization_type: payload.organization_type ?? null,\n      status: payload.status ?? 'unknown',\n      provider: payload.provider ?? null,\n      queries_run: payload.queries_run ?? 0,\n      candidates_found: payload.candidates_found ?? 0,\n      records_ingested: payload.records_ingested ?? 0,\n      duplicates: payload.duplicates ?? 0,\n      failures: payload.failures ?? 0,\n      error: payload.error ?? null,\n      started_at: payload.started_at ?? null,\n      completed_at: payload.completed_at ?? null,\n    },\n  };\n});"
      },
      "id": "f7a8b9c0-d1e2-4f3a-4b5c-6d7e8f901234",
      "name": "Track poll attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "queued",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "running",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Still waiting?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.attempt }}",
              "rightValue": 40,
              "operator": {
                "type": "number",
                "operation": "largerEqual",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5e",
      "name": "Poll limit reached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1880,
        100
      ]
    },
    {
      "parameters": {},
      "id": "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f",
      "name": "Poll timeout",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2120,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1e2f3a4-b5c6-4d7e-8f9a-0b1c2d3e4f5a",
      "name": "Status: completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1880,
        300
      ]
    },
    {
      "parameters": {},
      "id": "e1f2a3b4-c5d6-4e7f-8a9b-0c1d2e3f4a5b",
      "name": "Run successful (completed)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2120,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "not_configured",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "f1a2b3c4-d5e6-4f7a-8b9c-0d1e2f3a4b5c",
      "name": "Status: failed or not configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1880,
        440
      ]
    },
    {
      "parameters": {},
      "id": "a2b3c4d5-e6f7-4a8b-9c0d-1e2f3a4b5c6e",
      "name": "Report failure",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2120,
        440
      ]
    },
    {
      "parameters": {},
      "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6f",
      "name": "completed_with_failures (preserved)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2120,
        720
      ]
    }
  ],
  "connections": {
